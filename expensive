local function selectTab(targetPage)
    for _, t in ipairs(tabs) do
        t.page.Visible = false
        TweenService:Create(t.btn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(25, 25, 30),
            TextColor3 = Color3.fromRGB(160, 160, 175),
        }):Play()
        TweenService:Create(t.stroke, TweenInfo.new(0.15), {
            Transparency = 0.6, Color = Theme.StrokeColor,
        }):Play()
    end
    for _, t in ipairs(tabs) do
        if t.page == targetPage then
            t.page.Visible = true
            TweenService:Create(t.btn, TweenInfo.new(0.15), {
                BackgroundColor3 = Theme.Accent,
                TextColor3 = Color3.fromRGB(255, 255, 255),
            }):Play()
            TweenService:Create(t.stroke, TweenInfo.new(0.15), {
                Transparency = 0.4, Color = Theme.AccentSoft,
