    Instance.new("UICorner", tgl).CornerRadius = udimNew(1, 0)
    local knob = Instance.new("Frame")
    knob.AnchorPoint = v2new(0.5, 0.5)
    knob.Position = default and udim2New(1, -13, 0.5, 0) or udim2New(0, 13, 0.5, 0)
    knob.Size = udim2New(0, 18, 0, 18)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = tgl
    Instance.new("UICorner", knob).CornerRadius = udimNew(1, 0)
    local state = default
    local function upd(anim)
        local c = state and Theme.Accent or Color3.fromRGB(45, 45, 55)
        local p = state and udim2New(1, -13, 0.5, 0) or udim2New(0, 13, 0.5, 0)
        if anim then
            TweenService:Create(tgl, TweenInfo.new(0.15), {BackgroundColor3 = c}):Play()
            TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = p}):Play()
        else
            tgl.BackgroundColor3 = c
            knob.Position = p
        end
    end
    tgl.MouseButton1Click:Connect(function()
        state = not state
        upd(true)
        if callback then callback(state) end
    end)
    return {
        set = function(v, fire)
            if state == v then return end
            state = v
            upd(true)
            if fire and callback then callback(v) end
        end
    }
end

local function createSlider(page, title, desc, min, max, default, suffix, callback, isDecimal)
    local card = createCard(page, title, desc, 76)
    local valLbl = Instance.new("TextLabel")
    valLbl.AnchorPoint = v2new(1, 0)
    valLbl.Position = udim2New(1, -20, 0, 12)
    valLbl.Size = udim2New(0, 130, 0, 20)
    valLbl.BackgroundTransparency = 1
    valLbl.Font = Enum.Font.GothamBold
    if isDecimal then
        valLbl.Text = string.format("%.1f %s", default, suffix)
    else
        valLbl.Text = tostring(default) .. " " .. suffix
    end
    valLbl.TextColor3 = Theme.AccentSoft
    valLbl.TextSize = 12
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Parent = card
    local sliderBg = Instance.new("Frame")
    sliderBg.AnchorPoint = v2new(0, 1)
    sliderBg.Position = udim2New(0, 20, 1, -14)
    sliderBg.Size = udim2New(1, -40, 0, 6)
    sliderBg.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = card
    Instance.new("UICorner", sliderBg).CornerRadius = udimNew(1, 0)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = sliderBg
    Instance.new("UICorner", fill).CornerRadius = udimNew(1, 0)
    local knob = Instance.new("Frame")
    knob.AnchorPoint = v2new(0.5, 0.5)
    knob.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
    knob.Size = udim2New(0, 16, 0, 16)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = sliderBg
    Instance.new("UICorner", knob).CornerRadius = udimNew(1, 0)
    local dragging = false
    local function setFromX(x)
        local rel = mClamp((x - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * rel
        if isDecimal then
            val = mFloor(val * 10 + 0.5) / 10
            if val < min then val = min end
            if val > max then val = max end
            valLbl.Text = string.format("%.1f %s", val, suffix)
        else
            local step = 1
            if max - min > 100 then step = 5 end
            if max - min > 500 then step = 10 end
            val = mFloor(val / step) * step
            valLbl.Text = tostring(val) .. " " .. suffix
        end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        if callback then callback(val) end
    end
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true setFromX(input.Position.X)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

