}

local function getWeaponValues()
    local now = tick()
    if now - weaponCacheTime < 3 and #weaponCache > 0 then return weaponCache end
    weaponCacheTime = now
    weaponCache = {}
    local ok, weapons = pcall(function() return ReplicatedStorage.Weapons end)
    if ok and weapons then
        for _, v in ipairs(weapons:GetDescendants()) do
            local n = v.Name:lower()
            for _, key in ipairs(RECOIL_NAMES) do
                if n:find(key) then
                    if v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("Vector3Value") then
                        table.insert(weaponCache, v)
                    end
                    break
                end
            end
        end
    end
    return weaponCache
end

local function applyNoRecoil()
    local char = LP.Character
    if not char then return end
    for _, attr in ipairs(RECOIL_ATTRS) do
        pcall(function() char:SetAttribute(attr, 0) end)
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, attr in ipairs(RECOIL_ATTRS) do
            pcall(function() hum:SetAttribute(attr, 0) end)
        end
        if hum.CameraOffset.Magnitude > 0.001 then
            hum.CameraOffset = Vector3.new(0, 0, 0)
        end
    end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        for _, attr in ipairs(RECOIL_ATTRS) do
            pcall(function() tool:SetAttribute(attr, 0) end)
        end
    end
    for _, v in ipairs(getWeaponValues()) do
        if v.Parent then
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                if not noRecoilOrig[v] then noRecoilOrig[v] = v.Value end
                if v.Value ~= 0 then v.Value = 0 end
            elseif v:IsA("Vector3Value") then
                if not noRecoilOrig[v] then noRecoilOrig[v] = v.Value end
                if v.Value.Magnitude > 0 then v.Value = Vector3.new(0, 0, 0) end
            end
        end
    end
end

local function antiRecoilCamera()
    if not Config.NoRecoil.Enabled then lastSafeCF = cam and cam.CFrame or nil return end
    if not cam then return end
    if Config.Aim.Enabled then lastSafeCF = cam.CFrame return end
    if lastSafeCF then
        local currLook = cam.CFrame.LookVector
        local prevLook = lastSafeCF.LookVector
        local currPitch = mAsin(mClamp(currLook.Y, -1, 1))
        local prevPitch = mAsin(mClamp(prevLook.Y, -1, 1))
        if currPitch - prevPitch > 0.015 then
            cam.CFrame = lastSafeCF
            return
        end
    end
    lastSafeCF = cam.CFrame
end

function restoreNoRecoil()
    for v, val in pairs(noRecoilOrig) do
        if v.Parent then pcall(function() v.Value = val end) end
    end
    noRecoilOrig = {}
end

task.spawn(function()
    while task.wait(0.3) do
        if Config.NoRecoil.Enabled then pcall(applyNoRecoil) end
    end
end)

