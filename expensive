-- REACH (HITBOX EXPANDER)
-- ============================================================
local reachOriginals = {} -- [part] = {size, transparency}

local function applyReach(plr)
    if not Config.Reach.Enabled then return end
    if plr == LP or not plr.Character then return end

    for _, name in ipairs({"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso"}) do
        local part = plr.Character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            if not reachOriginals[part] then
                reachOriginals[part] = {size = part.Size, transparency = part.Transparency}
            end
            part.Size = Vector3.new(Config.Reach.Size, Config.Reach.Size, Config.Reach.Size)
            part.Transparency = 0.7
            part.CanCollide = false
        end
    end
end

local function restoreReach(plr)
    if not plr or not plr.Character then return end
    for _, name in ipairs({"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso"}) do
        local part = plr.Character:FindFirstChild(name)
        if part and reachOriginals[part] then
            part.Size = reachOriginals[part].size
            part.Transparency = reachOriginals[part].transparency
            part.CanCollide = true
            reachOriginals[part] = nil
        end
    end
end

function applyReachAll()
    if not Config.Reach.Enabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        applyReach(plr)
    end
end

function restoreReachAll()
    for plr, _ in pairs(reachOriginals) do
        if typeof(plr) == "Instance" then
            -- This is wrong, we need to iterate players
        end
    end
    -- Better implementation:
    for _, plr in ipairs(Players:GetPlayers()) do
        restoreReach(plr)
    end
    table.clear(reachOriginals)
end

-- Keep Reach updated every frame
RunService.Heartbeat:Connect(function()
    if Config.Reach.Enabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            applyReach(plr)
        end
    end
end)

