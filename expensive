    diamond.BorderSizePixel = 0
    diamond.Parent = logoBox
    Instance.new("UICorner", diamond).CornerRadius = udimNew(0, 8)
    local dStroke = Instance.new("UIStroke")
    dStroke.Color = color dStroke.Thickness = 3 dStroke.LineJoinMode = Enum.LineJoinMode.Round dStroke.Parent = diamond

    local t1 = Instance.new("TextLabel")
    t1.BackgroundTransparency = 1
    t1.Position = udim2New(0, 76, 0, 14)
    t1.Size = udim2New(1, -92, 0, 18)
    t1.Font = Enum.Font.GothamBold
    t1.Text = title
    t1.TextColor3 = Color3.fromRGB(255, 255, 255)
    t1.TextSize = 14
    t1.TextXAlignment = Enum.TextXAlignment.Left
    t1.Parent = f

    local t2 = Instance.new("TextLabel")
    t2.BackgroundTransparency = 1
    t2.Position = udim2New(0, 76, 0, 34)
    t2.Size = udim2New(1, -92, 0, 16)
    t2.Font = Enum.Font.Gotham
