local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local friendCache = {}
local function isFriend(plr)
    local c = friendCache[plr.UserId]
    if c ~= nil then return c end
    local ok, res = pcall(LP.IsFriendsWith, LP, plr.UserId)
    res = ok and res or false
    friendCache[plr.UserId] = res
    return res
end
Players.PlayerRemoving:Connect(function(p) friendCache[p.UserId] = nil end)

local function isZoomed()
    if not cam then return false end
    local fov = cam.FieldOfView
    if not zoomBaseline then zoomBaseline = fov end
    if fov > zoomBaseline then zoomBaseline = fov end
    if (zoomBaseline - fov) >= 8 then return true end
    local char = LP.Character
    if char then
        for _, attr in ipairs({"Zooming", "Aiming", "Zoomed", "IsAiming", "SniperZoom", "Scoped", "IsScoped", "ADS"}) do
            local v = char:GetAttribute(attr)
            if v == true or (type(v) == "number" and v > 0) then return true end
        end
    end
    return false
end

local function hasLOS(char)
    local myChar = LP.Character
    if not myChar or not char then return false end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot or not tRoot then return false end
    rayParams.FilterDescendantsInstances = {myChar, char}
    return workspace:Raycast(cam.CFrame.Position, tRoot.Position - cam.CFrame.Position, rayParams) == nil
end

local activeHL = {}
local function getHighlightColor(plr, char)
    if Config.Highlight.HighlightFriends and isFriend(plr) then
        return Config.Highlight.FriendColor, true
    end
    local vis = hasLOS(char)
    return vis and Config.Highlight.VisibleColor or Config.Highlight.HiddenColor, false
end

local function createHighlight(plr, char)
    if activeHL[plr] then return end
    if not char:FindFirstChild("HumanoidRootPart") then
        if not char:WaitForChild("HumanoidRootPart", 5) then return end
    end
    local color, isFriendFlag = getHighlightColor(plr, char)
    local hl = Instance.new("Highlight")
    hl.Name = "ExpHL"
    hl.FillColor = color
    hl.FillTransparency = isFriendFlag and 0.55 or (hasLOS(char) and 0.5 or 0.65)
    hl.OutlineColor = color
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char
    activeHL[plr] = {hl = hl, lastColor = color}
end

local function removeHighlight(plr)
    local d = activeHL[plr]
    if not d then return end
    if d.hl then d.hl:Destroy() end
    activeHL[plr] = nil
end

function enableAllHighlights()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then createHighlight(plr, plr.Character) end
    end
end
function disableAllHighlights()
    for plr in pairs(activeHL) do removeHighlight(plr) end
end

local hlNext = 0
local function updateHLVisibility()
    local now = tick()
    if now - hlNext < 0.2 then return end
    hlNext = now
    for plr, d in pairs(activeHL) do
        local char = plr.Character
        if not char or not d.hl then removeHighlight(plr)
        else
            local color, isFriendFlag = getHighlightColor(plr, char)
            if color ~= d.lastColor then
                d.lastColor = color
                d.hl.FillColor = color
                d.hl.OutlineColor = color
                d.hl.FillTransparency = isFriendFlag and 0.55 or (hasLOS(char) and 0.5 or 0.65)
            end
        end
    end
end

local activeESP = {}
