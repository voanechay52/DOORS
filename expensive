local BIND = "Expensive_v44_main"
RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value + 1000, function()
    if not cam then return end
    if Config.Aim.Enabled then
        if not aimAlive(aimTarget) then
            aimTarget = findAimTarget()
        end

        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and Config.Aim.RotateChar then hum.AutoRotate = false end

        if aimTarget then
            circleStroke.Color = Color3.fromRGB(140, 225, 160)

            -- 1. Двигаем реальную мышь
            if not menuOpen and Config.Aim.UseMouse then
                pcall(moveMouseToTarget)
            end

            -- 2. ЖЁСТКАЯ фиксация камеры на голове
            cam.CFrame = cfLookAt(cam.CFrame.Position, aimTarget.Position)

            -- 3. Поворот персонажа (мгновенный или плавный)
            if root and Config.Aim.RotateChar then
                local targetPos = aimTarget.Position
                local myPos = root.Position
                local dirXZ = v3new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
                if dirXZ.Magnitude > 0.5 then
                    local desiredRootCF = cfLookAt(myPos, myPos + dirXZ)
                    local alpha = Config.Aim.Smoothness
                    if alpha <= 0.01 then
                        root.CFrame = desiredRootCF
                    else
                        root.CFrame = root.CFrame:Lerp(desiredRootCF, alpha)
                    end
                end
            end
        else
            circleStroke.Color = Theme.AccentSoft
        end
    end

    if Config.Trigger.Enabled then
        local nowZoomed = isZoomed()
        if nowZoomed and not wasZoomed then zoomStartTime = tick() end
        if not nowZoomed then zoomStartTime = nil end
        wasZoomed = nowZoomed
        if nowZoomed and zoomStartTime and (tick() - zoomStartTime >= Config.Trigger.ZoomDelay) then
            local t = findTriggerTarget()
            if t then
                local now = tick()
                if now - lastClick >= Config.Trigger.Cooldown then
                    lastClick = now clickNow()
                end
            end
        end
    end
    if Config.Highlight.Enabled then updateHLVisibility() end
end)

