function refreshAllESP()
    for plr in pairs(activeESP) do removeESPFor(plr) end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then createESPFor(plr) end
    end
end

local function updateESP()
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position
    for plr, d in pairs(activeESP) do
        local char = plr.Character
        if not char then removeESPFor(plr)
        else
            if d.hp then
                local show = true
                if myPos then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - myPos).Magnitude
                        if dist > Config.ESP.HPRadius then show = false end
                    end
                end
                d.hp.Enabled = show
                if show then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local l = d.hp:FindFirstChild("HPLabel")
                    if hum and l then
                        l.TextSize = Config.ESP.HPSize
                        l.Text = mFloor(hum.Health) .. " / " .. mFloor(hum.MaxHealth)
                        local r = hum.Health / math.max(hum.MaxHealth, 1)
                        if r > 0.6 then l.TextColor3 = Color3.fromRGB(140, 225, 160)
                        elseif r > 0.3 then l.TextColor3 = Color3.fromRGB(255, 215, 130)
                        else l.TextColor3 = Color3.fromRGB(255, 100, 100) end
                    end
                    d.hp.StudsOffset = getOffset(Config.ESP.HPPos)
                end
            end
        end
    end
end

local function findAimTarget()
    if not cam then return nil end
    local myChar = LP.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local myPos = myRoot.Position
    local radSq = Config.Aim.Radius ^ 2
    local best, bestD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            if not (Config.Aim.SkipFriends and isFriend(plr)) then
                local char = plr.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local head = char:FindFirstChild("Head")
                        if head then
                            local pos, onScreen = cam:WorldToViewportPoint(head.Position)
                            if onScreen and pos.Z > 0 then
                                local dx, dy = pos.X - centerX, pos.Y - centerY
                                if dx*dx + dy*dy <= radSq then
                                    local d = (head.Position - myPos).Magnitude
                                    if d <= Config.Aim.MaxDist and d < bestD then
                                        bestD = d
                                        best = head
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function aimAlive(t)
    if not t or not t.Parent then return false end
    local hum = t.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local plr = Players:GetPlayerFromCharacter(t.Parent)
    if plr and Config.Aim.SkipFriends and isFriend(plr) then return false end
    return true
end

local function findTriggerTarget()
    if not cam then return nil end
    local myChar = LP.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best, bestD = nil, math.huge
    local myPos = myRoot.Position
    local sSq = Config.Trigger.ScreenRad ^ 2
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            if not (Config.Aim.SkipFriends and isFriend(plr)) then
                local char = plr.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local head = char:FindFirstChild("Head")
                        if head then
                            local d = (head.Position - myPos).Magnitude
                            if d <= Config.Trigger.MaxDist then
                                local pos, onScreen = cam:WorldToViewportPoint(head.Position)
                                if onScreen and pos.Z > 0 then
                                    local dx, dy = pos.X - centerX, pos.Y - centerY
                                    if dx*dx + dy*dy <= sSq then
                                        rayParams.FilterDescendantsInstances = {myChar, char}
                                        if workspace:Raycast(cam.CFrame.Position, head.Position - cam.CFrame.Position, rayParams) == nil then
                                            if d < bestD then bestD = d best = head end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

