    t2.TextColor3 = Color3.fromRGB(180, 182, 192)
    t2.TextSize = 12
    t2.TextXAlignment = Enum.TextXAlignment.Left
    t2.Parent = f

    activeNotif = f
    TweenService:Create(f, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = udim2New(0.5, 0, 0, 16)
    }):Play()
    TweenService:Create(s, TweenInfo.new(0.3), {Transparency = 0.15}):Play()

