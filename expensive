-- AIM MOUSE (СИЛЬНЫЙ МАГНИТ)
-- ============================================================
local AIM_SENSITIVITY = 0.0025

local function moveMouseToTarget()
    if not Config.Aim.UseMouse then return end
    if not mousemoverel then return end
    if not aimTarget or not aimTarget.Parent then return end
    if not cam then return end

    local camPos = cam.CFrame.Position
    local desiredCF = cfLookAt(camPos, aimTarget.Position)
    local currentLook = cam.CFrame.LookVector
    local desiredLook = desiredCF.LookVector

    local currentYaw = mAtan2(-currentLook.X, -currentLook.Z)
    local desiredYaw = mAtan2(-desiredLook.X, -desiredLook.Z)
    local deltaYaw = desiredYaw - currentYaw
    if deltaYaw > math.pi then deltaYaw = deltaYaw - math.pi * 2
    elseif deltaYaw < -math.pi then deltaYaw = deltaYaw + math.pi * 2 end

    local currentPitch = mAsin(mClamp(currentLook.Y, -1, 1))
    local desiredPitch = mAsin(mClamp(desiredLook.Y, -1, 1))
    local deltaPitch = desiredPitch - currentPitch

    local px = -deltaYaw / AIM_SENSITIVITY
    local py = -deltaPitch / AIM_SENSITIVITY

    -- Убрали ограничение MaxPixels (или ставим огромное)
    if Config.Aim.MaxPixels and Config.Aim.MaxPixels < 900 then
        local mag = mSqrt(px*px + py*py)
        if mag > Config.Aim.MaxPixels then
            local k = Config.Aim.MaxPixels / mag
            px = px * k
            py = py * k
        end
    end

    pcall(function() mousemoverel(px, py) end)
end

